# Uploaded pictures are served, never executed. Even if something that is not
# an image reaches this folder, Apache must not run it.
php_flag engine off
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(?i:php|phtml|phar|php3|php4|php5|php7|phps|cgi|pl|py|asp|aspx|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
