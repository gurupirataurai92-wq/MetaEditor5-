# Copy to .env and adjust. Every value below has a safe development default,
# but JWT_SECRET MUST be set to a long random string before deploying.

PORT=3000

# Signing key for auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login stays valid.
TOKEN_TTL=7d

# SQLite database location (created automatically on first boot).
DB_FILE=./data/haulr.db

# Currency shown throughout the UI.
CURRENCY_CODE=ZAR
CURRENCY_SYMBOL=R

# Radius (km) used to decide which open jobs an operator can see.
DISPATCH_RADIUS_KM=25

# How long an on-duty operator's last GPS fix stays valid before they drop off
# the customer-facing maps.
OPERATOR_STALE_MINUTES=10
